# Copy to rimss-app/.env (Vite loads it automatically).
VITE_API_BASE_URL=http://localhost:4000/api
# Optional: endpoint that receives telemetry and analytics events.
VITE_TELEMETRY_URL=
# Optional: Google Analytics 4 measurement id (G-XXXXXXX); GA is off when empty.
VITE_GA_MEASUREMENT_ID=
# Optional: comma-separated module ids to disable.
VITE_DISABLED_MODULES=
