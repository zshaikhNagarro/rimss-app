# Copy to rimss-api/.env and export, or set in your host. Without DATABASE_URL the API falls back to in-memory/JSON storage.
DATABASE_URL=postgres://rimss:rimss@localhost:5432/rimss
DATABASE_SSL=false
# Managed Postgres with a private CA: paste the PEM (use \n for newlines). Verification is on by default.
DATABASE_SSL_CA=
# Only for throwaway environments; disables certificate verification.
DATABASE_SSL_INSECURE=false
LOG_LEVEL=info
PORT=4000
CORS_ORIGINS=http://localhost:5173
ADMIN_API_KEY=change-me
# Optional; generated and stored in rimss-api/data/vapid.json when running without a database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
